#!/usr/bin/env bash
# pre-push: protect the HuggingFace Streamlit Space from accidental deploys.
#
# Why this exists
# ---------------
# The HF Space ``main`` branch has no native branch-protection (HF doesn't
# expose those rules), so anyone with write access — including
# accidental web-edits via the Space's Files tab — can push directly.
# That's exactly how ``main`` got reverted on 2026-04-20, dropping
# ~7 300 lines of work.
#
# What it checks
# --------------
# The pushed commit's **tree** must match ``origin/main``'s tree, ignoring
# the paths listed in ``scripts/hf-deploy-excludes.txt``. In other words:
# "you may deploy anything, as long as what lands on the Space is main."
#
# It deliberately does NOT compare SHAs. The deploy commit can never share
# a SHA with ``origin/main``:
#
#   * it strips binaries the Space won't accept, so its tree differs; and
#   * the Space's history is unrelated to main's (its own root commit, no
#     merge base), so the deploy commit is built on the Space's tip.
#
# An earlier version of this hook required ``local_sha == origin/main``.
# That is unsatisfiable for any real deploy, so every legitimate push had
# to be forced through with ``--no-verify`` — which meant the guard was
# routinely bypassed and protected nothing. Comparing trees keeps the
# 2026-04-20 scenario blocked (a stale or reverted tree differs in tracked
# source files) while letting correct deploys through untouched.
#
# Bypass (intentional)
# --------------------
# ``git push --no-verify hf-streamlit …`` skips the hook. With the tree
# check in place you should essentially never need this; if you do, it
# means the thing you're pushing is not main, so be sure that's deliberate.
#
# Installation
# ------------
# From the repo root, once per clone:
#
#     git config core.hooksPath scripts/git-hooks
#
# That points Git at this directory for *every* hook (pre-commit,
# pre-push, etc.) so the team gets the same protection without
# symlinking individual files.

set -euo pipefail

remote_name="$1"
remote_url="$2"

# Only intervene for HF Space pushes. Pushes to GitHub origin or any
# other remote are out of scope.
case "$remote_url" in
  *huggingface.co/spaces/*) ;;
  *)
    exit 0
    ;;
esac

repo_root="$(git rev-parse --show-toplevel)"
lib="$repo_root/scripts/hf-deploy-lib.sh"
if [[ ! -f "$lib" ]]; then
  printf '✗ Missing %s — cannot verify this deploy. Refusing.\n' "$lib" >&2
  exit 1
fi
# shellcheck source=../hf-deploy-lib.sh
. "$lib"

# Read the list of refs being pushed from stdin. Format per `man githooks`:
#   <local-ref> <local-sha> <remote-ref> <remote-sha>
# We only care about pushes that update ``refs/heads/main`` on the Space.
deploy_violation=0
deploy_messages=()

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip the all-zero local_sha — that's a delete request, harmless here.
  if [[ "$local_sha" =~ ^0+$ ]]; then
    continue
  fi
  # Only enforce on the production branch.
  if [[ "$remote_ref" != "refs/heads/main" ]]; then
    continue
  fi

  # Make sure we have an up-to-date origin/main to compare against. If
  # the user hasn't fetched recently, the comparison would be stale.
  if ! git fetch --quiet origin main 2>/dev/null; then
    deploy_messages+=("✗ Could not fetch origin/main — check your network or 'origin' remote.")
    deploy_violation=1
    continue
  fi

  origin_main_sha="$(git rev-parse origin/main)"

  # The check: which tracked paths differ, once expected binary
  # exclusions are discounted?
  unexpected="$(hf_deploy_unexpected_diff "$local_sha" "$origin_main_sha")"

  if [[ -z "$unexpected" ]]; then
    # Happy path: what lands on the Space is main.
    continue
  fi

  # Failure path: the tree is not main. Diagnose loudly, and show the
  # offending paths — that's what tells you *how* it diverged.
  file_count="$(printf '%s\n' "$unexpected" | grep -c .)"
  deploy_messages+=("")
  deploy_messages+=("✗ Refusing to deploy to ${remote_name} (HuggingFace Streamlit Space).")
  deploy_messages+=("")
  deploy_messages+=("  You're pushing:     ${local_sha:0:12}  ($(git log -1 --format='%s' "$local_sha"))")
  deploy_messages+=("  origin/main tip is: ${origin_main_sha:0:12}  ($(git log -1 --format='%s' "$origin_main_sha"))")
  deploy_messages+=("")
  deploy_messages+=("  Its tree differs from origin/main in ${file_count} tracked path(s)")
  deploy_messages+=("  beyond the expected binary exclusions:")
  deploy_messages+=("")
  while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    deploy_messages+=("    - ${path}")
  done <<< "$(printf '%s\n' "$unexpected" | head -20)"
  if [[ "$file_count" -gt 20 ]]; then
    deploy_messages+=("    … and $((file_count - 20)) more")
  fi
  deploy_messages+=("")
  deploy_messages+=("  What lands on the Space must be origin/main. To proceed:")
  deploy_messages+=("    1. Merge your work to main (PR + CI green).")
  deploy_messages+=("    2. git fetch origin")
  deploy_messages+=("    3. scripts/sync_to_hf.sh")
  deploy_messages+=("")
  deploy_messages+=("  Deploying something other than main on purpose? Re-run with --no-verify:")
  deploy_messages+=("    git push --no-verify ${remote_name} <sha>:main")
  deploy_messages+=("")
  deploy_violation=1
done

if [[ $deploy_violation -eq 1 ]]; then
  for line in "${deploy_messages[@]}"; do
    printf '%s\n' "$line" >&2
  done
  exit 1
fi

exit 0
